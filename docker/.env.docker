# Docker environment variables
# Copy this to .env when running with Docker

# API URL - for production, set this to your domain
# API_URL=https://your-domain.com/api

# Config Cache Timeout
VITE_CONFIG_CACHE_TIMEOUT=5000

# Server Port (internal port in container)
PORT=3000

# Redis configuration
REDIS_URL=redis://redis:6379

# Session configuration
SESSION_SECRET=your-session-secret-here
SESSION_NAME=raopoc_session
SESSION_MAX_AGE=86400000

# Encryption configuration (optional)
# If not provided, a key will be auto-generated and saved to /app/data/.encryption-key
# To generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=your-base64-encoded-32-byte-key-here

# Node environment
NODE_ENV=production