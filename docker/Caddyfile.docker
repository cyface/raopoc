# Caddyfile for Docker production deployment
# Handles HTTPS, reverse proxy, static file serving, and caching

# Global options
{
	# Enable the admin API
	admin off
	
	# Auto HTTPS settings
	auto_https on
	
	# Email for Let's Encrypt (optional)
	# email admin@example.com
}

# Main application domain
https://app.localhost, app.localhost:443 {
	# Enable automatic HTTPS with self-signed certificates for localhost
	# For production domains, Caddy will automatically get Let's Encrypt certificates
	tls internal

	# Security headers
	header {
		# Enable HSTS
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# Prevent MIME type sniffing
		X-Content-Type-Options "nosniff"
		# Enable XSS protection
		X-XSS-Protection "1; mode=block"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove server header
		-Server
	}

	# Handle API routes - proxy to NestJS backend
	handle /api/* {
		reverse_proxy app:3000 {
			# Add forwarded headers
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			
			# Health check
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
			health_status 200
		}
	}

	# Handle static assets with caching
	@static {
		path *.js *.css *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ttf *.eot
	}
	handle @static {
		root * /srv/app
		file_server
		
		# Cache control for static assets
		header {
			# Cache for 1 year for versioned assets
			?Cache-Control "public, max-age=31536000, immutable"
			
			# Conditional caching based on environment variable
			@cache_enabled expression {env.CACHE_ENABLED} == "true"
			Cache-Control @cache_enabled "public, max-age={env.CACHE_MAX_AGE}, stale-while-revalidate={env.CACHE_STALE_WHILE_REVALIDATE}"
		}
	}

	# Handle SPA routes - serve index.html for all non-API, non-static routes
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
		
		# No caching for HTML
		header /index.html {
			Cache-Control "no-cache, no-store, must-revalidate"
			Pragma "no-cache"
			Expires "0"
		}
	}

	# Compression
	encode gzip zstd

	# Logging
	log {
		output stdout
		format console
		level INFO
	}
}

# API subdomain (alternative access point)
https://api.localhost, api.localhost:443 {
	tls internal

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		-Server
	}

	# Proxy all requests to the NestJS backend
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# CORS headers for API subdomain
	header {
		Access-Control-Allow-Origin "https://app.localhost"
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS, PATCH"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
		Access-Control-Allow-Credentials "true"
		Access-Control-Max-Age "86400"
	}

	# Handle OPTIONS requests
	@options method OPTIONS
	respond @options 204

	# Compression
	encode gzip zstd

	# Logging
	log {
		output stdout
		format console
		level INFO
	}
}

# HTTP to HTTPS redirect
http://app.localhost, http://api.localhost {
	redir https://{host}{uri} permanent
}