{
  "name": "raopoc",
  "version": "1.0.0",
  "description": "Bank customer onboarding application",
  "type": "module",
  "packageManager": "pnpm@10.12.2+sha512.a32540185b964ee30bb4e979e405adc6af59226b438ee4cc19f9e8773667a66d302f5bfee60a39d3cac69e35e4b96e708a71dd002b7e9359c4112a1722ac323f",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"sleep 2 && pnpm dev:frontend\"",
    "dev:frontend": "vite --host",
    "dev:server": "cd server && nest start --watch",
    "dev:https": "concurrently \"pnpm dev:server\" \"sleep 2 && pnpm dev:frontend\" \"sleep 2 && pnpm dev:caddy\"",
    "dev:caddy": "caddy run --config Caddyfile",
    "build": "tsc && vite build",
    "build:server": "cd server && nest build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky || true",
    "prisma:migrate": "prisma migrate dev",
    "generate-pdfs": "tsx scripts/generate-pdfs.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/serve-static": "^5.0.3",
    "@prisma/client": "^6.10.1",
    "@types/express": "^5.0.3",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^4.0.20",
    "chokidar": "^3.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "clsx": "^2.1.1",
    "connect-redis": "^9.0.0",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.468.0",
    "pnpm": "10.12.2",
    "prisma": "^6.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.3",
    "react-router-dom": "^6.30.1",
    "redis": "^5.5.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/connect-redis": "^0.0.23",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.1",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "2.1.9",
    "concurrently": "^8.2.2",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "pdfkit": "^0.17.1",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^5.4.19",
    "vitest": "^2.1.9"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
